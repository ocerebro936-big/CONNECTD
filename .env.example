# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CALLS_API_URL: URL do Worker Cloudflare (connected-api) para chamadas
# Cloud (Realtime SFU/PartyTracks) e DIVINO IA. Vazio = chamadas P2P (fallback).
# Exemplo: VITE_CALLS_API_URL="https://connected-api.SUBDOMINIO.workers.dev"
VITE_CALLS_API_URL=""

# === Connected Cloud Storage — S3-compatible (PR #6) ===
# Se definidas, o disco físico CCS passa a ser S3-compatible (AWS/R2).
# As credenciais AWS NUNCA saem do servidor (Cloud Function ccsPresign).
# VITE_CCS_PRESIGN_URL: endpoint da Cloud Function ccsPresign (regionURL/.../ccsPresign)
VITE_CCS_PRESIGN_URL=""
# VITE_CCS_CDN_BASE: base pública dos objetos (ex.: https://cdn.connectedking.web.app ou endpoint S3 público)
VITE_CCS_CDN_BASE=""
#
# Função (functions) requer env: CCS_BUCKET, AWS_REGION e credenciais AWS
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY ou Application Default Credentials).

