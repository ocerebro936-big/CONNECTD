# Connected Cloud Gateway — variáveis de ambiente
# ⚠️ NUNCA comites valores reais. Os segredos vivem no ambiente de produção
# (secrets do host ou do GitHub Actions). Copia para `.env` localmente p/ dev.

# Porta de escuta
PORT=8787

# Chave de API Gateway<->Node. Se definida, o cliente DEVE enviar `x-ccs-key`.
# Em produção define ISTO como secret do host (não aqui).
CCS_API_KEY=dev-change-me

# Chave para assinar URLs de conteúdo autorizado (Edge/CDN).
# Em produção define ISTO como secret do host (não aqui).
CCS_SIGN_KEY=dev-change-me-sign

# Nós de object storage (replicação/backup)
CCS_NODES=node-a,node-b

# Limite de upload por ficheiro (bytes) — 2GB
CCS_MAX_BYTES=2147483648

# Rate limit por IP (req/s)
CCS_RATE=60

# Escritas concorrentes máximas
CCS_CONCURRENCY=20

# Limite de transferência por replicação (bytes) — 5GB
CCS_REPLICA_LIMIT=5368709120

# CORS restrito à Connected King (+ localhost em dev). VIRGULA-separado.
CCS_ALLOWED_ORIGINS=http://localhost:8787,https://connectedking.web.app
