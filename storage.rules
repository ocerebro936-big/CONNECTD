rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 20 * 1024 * 1024;
    }

    match /{prefix}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        prefix.matches("^(photos|videos|reels|stories|gallery|chat|gifts|games|tv|lives|documents|posts)$") &&
        request.resource.size < 100 * 1024 * 1024;
    }

    // Connected Cloud Storage — ficheiros dos utilizadores (até 2 GB)
    match /cloud/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 2 * 1024 * 1024 * 1024;
    }

    // Connected Music — áudio (até 50 MB) e capas dos utilizadores
    match /music/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 50 * 1024 * 1024;
    }

    match /music/covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
